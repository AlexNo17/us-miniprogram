<view class="page">
  <view class="row space-between"><view><view class="title">一起去做</view><view class="subtitle">把“以后”变成一个具体的日子</view></view><button class="add" bindtap="openForm">＋</button></view>
  <view class="filters"><view class="filter {{filter==='想做'?'active':''}}" data-filter="想做" bindtap="setFilter">想做</view><view class="filter {{filter==='已完成'?'active':''}}" data-filter="已完成" bindtap="setFilter">已完成</view></view>
  <view class="plan card" wx:for="{{filtered}}" wx:key="id"><view class="check {{item.done?'done':''}}" data-id="{{item.id}}" bindtap="toggle">{{item.done?'✓':''}}</view><view class="grow"><view class="plan-title">{{item.title}}</view><view class="meta"><text class="pill">{{item.category}}</text><text>{{item.date}}</text></view></view><view class="delete" data-id="{{item.id}}" bindtap="remove">删除</view></view>
  <view class="empty" wx:if="{{!filtered.length}}">这里还空着，一起写下一个期待吧。</view>
</view>
<view class="overlay" wx:if="{{showForm}}" bindtap="closeForm"><view class="sheet" catchtap="noop"><view class="sheet-title">新的共同计划</view><input class="input" maxlength="50" placeholder="我们想一起做什么？" value="{{title}}" bindinput="onInput"/><picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="input">分类：{{categories[categoryIndex]}}</view></picker><picker mode="date" value="{{date}}" bindchange="onDate"><view class="input">计划日期：{{date}}</view></picker><button class="btn" bindtap="save">加入愿望清单</button></view></view>
