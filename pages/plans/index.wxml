<view class="page">
  <view class="row space-between"><view><view class="title">计划</view><view class="subtitle">把想做的事慢慢变成回忆</view></view><button class="add" bindtap="openForm">＋</button></view>
  <view class="filters"><view class="filter {{filter==='想做'?'active':''}}" data-filter="想做" bindtap="setFilter">想做</view><view class="filter {{filter==='已完成'?'active':''}}" data-filter="已完成" bindtap="setFilter">已完成</view></view>
  <view class="plan card" wx:for="{{filtered}}" wx:key="id"><view class="check {{item.done?'done':''}}" data-id="{{item.id}}" catchtap="toggle">{{item.done?'✓':''}}</view><view class="grow" data-id="{{item.id}}" bindtap="openDetail"><view class="plan-title">{{item.title}}</view><view class="meta"><text class="pill">{{item.category}}</text><text>{{item.date || '日期待定'}}</text></view></view><view data-id="{{item.id}}" bindtap="openDetail">›</view></view>
  <view class="empty" wx:if="{{!filtered.length}}" bindtap="openForm">{{filter === '想做' ? '还没有计划，点这里添加' : '完成的计划会出现在这里'}}</view>
</view>
<view class="overlay" wx:if="{{detail}}" bindtap="closeDetail"><view class="sheet" catchtap="noop"><view class="sheet-title">{{detail.title}}</view><view class="muted small">{{detail.category}} · {{detail.date || '日期待定'}} · {{detail.done ? '已完成' : '想做'}}</view><view class="detail-text">{{detail.content || '还没有填写备注。'}}</view><button wx:if="{{detail.done && (detail.category === '电影' || detail.category === '地点')}}" class="secondary full" bindtap="saveMemory">保存为回忆</button><view class="actions"><button class="secondary" bindtap="edit">编辑</button><button class="secondary" bindtap="remove">删除</button><button class="secondary" data-id="{{detail.id}}" bindtap="toggle">{{detail.done ? '取消完成' : '完成'}}</button></view></view></view>
<view class="overlay" wx:if="{{showForm}}" bindtap="closeForm"><view class="sheet" catchtap="noop"><view class="sheet-title">{{form.id ? '编辑计划' : '新的共同计划'}}</view><input class="input" maxlength="50" placeholder="我们想一起做什么？" value="{{form.title}}" data-field="title" bindinput="input"/><picker range="{{categories}}" bindchange="category"><view class="input">分类：{{form.category}} ›</view></picker><textarea class="input textarea" maxlength="500" placeholder="备注（选填）" value="{{form.content}}" data-field="content" bindinput="input"/><view class="row"><picker class="grow" mode="date" value="{{form.date || today}}" bindchange="date"><view class="input">计划日期：{{form.date || '未设置（选填）'}} ›</view></picker><view wx:if="{{form.date}}" class="clear" bindtap="clearDate">清除</view></view><button class="btn" bindtap="save">保存计划</button></view></view>
