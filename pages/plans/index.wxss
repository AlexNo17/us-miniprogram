.add { width: 76rpx; height: 76rpx; padding: 0; border-radius: 50%; background: #e76f87; color: #fff; font-size: 42rpx; line-height: 72rpx; }.add::after { border: 0; }.filters { display: flex; gap: 12rpx; margin: 40rpx 0 10rpx; padding: 8rpx; border-radius: 24rpx; background: #f5ece9; }.filter { flex: 1; padding: 18rpx; border-radius: 18rpx; text-align: center; color: #95837e; font-size: 26rpx; }.active { background: #fff; color: #d85f77; font-weight: 600; box-shadow: 0 5rpx 15rpx rgba(70,40,35,.06); }.plan { display: flex; align-items: center; gap: 24rpx; margin-top: 18rpx; padding: 28rpx; }.check { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; border: 3rpx solid #e9b3bd; border-radius: 50%; color: #fff; }.check.done { border-color: #e76f87; background: #e76f87; }.grow { flex: 1; }.plan-title { font-size: 29rpx; font-weight: 600; }.meta { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; color: #aa9995; font-size: 22rpx; }.meta .pill { padding: 6rpx 14rpx; font-size: 21rpx; }

.delete { padding: 10rpx; color: #baaaa5; font-size: 22rpx; }
