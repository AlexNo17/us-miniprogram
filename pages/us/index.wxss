.profile { padding: 45rpx 30rpx; text-align: center; }.avatars { display: flex; align-items: center; justify-content: center; }.avatar { display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 8rpx solid #fff; border-radius: 50%; background: #f3a1b1; color: #fff; font-size: 38rpx; box-shadow: 0 8rpx 25rpx rgba(100,60,60,.12); }.avatar.second { background: #91a8ce; }.heart { z-index: 2; margin: 0 -8rpx; color: #e76f87; font-size: 35rpx; }.names { margin-top: 24rpx; font-size: 36rpx; font-weight: 700; }.stats { display: flex; justify-content: space-around; padding: 30rpx 10rpx; }.stats view { flex: 1; text-align: center; border-right: 1rpx solid #f0e6e3; }.stats view:last-child { border: 0; }.stats text { display: block; font-family: Georgia, serif; color: #dc667e; font-size: 44rpx; }.stats label { color: #9e8d88; font-size: 22rpx; }.menu { padding: 4rpx 28rpx; }.menu view { display: flex; align-items: center; padding: 29rpx 0; border-bottom: 1rpx solid #f4ecea; font-size: 28rpx; }.menu view:last-child { border: 0; }.menu text { width: 60rpx; color: #e2778d; font-size: 32rpx; }.menu label { margin-left: auto; color: #baa9a5; font-size: 36rpx; }.promise { margin-top: 40rpx; color: #b4a5a0; text-align: center; font-size: 22rpx; }
