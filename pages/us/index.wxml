<view class="page">
  <view class="empty" wx:if="{{loading}}">正在加载云端资料…</view><view class="empty" wx:elif="{{!cloudReady}}" bindtap="loadCloud">云端暂时无法连接，点此重试</view>
  <view class="profile card" wx:if="{{cloudReady}}"><view class="avatars"><view class="avatar"><image wx:if="{{profile.avatarA}}" class="avatar-image" src="{{profile.avatarA}}" mode="aspectFill"/><text wx:else>{{profile.me[0]}}</text></view><view class="avatar second"><image wx:if="{{profile.avatarB}}" class="avatar-image" src="{{profile.avatarB}}" mode="aspectFill"/><text wx:else>{{profile.partner[0]}}</text></view></view><view class="names">{{profile.me}} 和 {{profile.partner}}</view><view class="subtitle">{{profile.startDate ? profile.startDate + ' · 故事开始的日子' : '设置属于你们的开始日期'}}</view><view class="edit-link" bindtap="edit">编辑我们的资料 ›</view></view>
  <view class="stats card"><view><text>{{days}}</text><label>相爱天数</label></view><view><text>{{momentCount}}</text><label>共同回忆</label></view><view><text>{{doneCount}}</text><label>完成计划</label></view></view>
  <view class="card partner-card" wx:if="{{cloudReady}}">
    <view class="row space-between"><view><view class="partner-title">关于{{profile.partner}}</view><view class="partner-subtitle">把她的小细节记下来</view></view><view class="partner-edit" bindtap="edit">编辑 ›</view></view>
    <view class="partner-grid"><view><text class="partner-label">星座</text><text class="partner-value">{{profile.partnerZodiac || '待填写'}}</text></view><view><text class="partner-label">MBTI</text><text class="partner-value">{{profile.partnerMbti || '待填写'}}</text></view><view><text class="partner-label">上升星座</text><text class="partner-value">{{profile.partnerRising || '待填写'}}</text></view></view>
    <view class="partner-memo"><view class="partner-label">关于她的备忘录</view><view class="memo-content {{profile.partnerMemo ? '' : 'memo-empty'}}">{{profile.partnerMemo || '喜欢吃什么、特别的习惯……都可以记在这里。'}}</view></view>
  </view>
  <view class="row space-between"><view class="section-title">关于我们</view><view class="edit-link" bindtap="addRecord">＋ 添加记录</view></view>
  <view class="card about" wx:for="{{about}}" wx:key="id"><view class="row space-between"><view class="pill">{{item.owner === '成员 A' ? profile.me : item.owner === '成员 B' ? profile.partner : '共同'}}</view><view><text class="record-action" data-id="{{item.id}}" bindtap="editRecord">编辑</text><text class="record-action" data-id="{{item.id}}" bindtap="deleteRecord">删除</text></view></view><view class="entry-title">{{item.title}}</view><view class="record-content">{{item.content}}</view><image wx:if="{{item.images.length}}" class="about-image" src="{{item.images[0]}}" mode="aspectFill" data-id="{{item.id}}" bindtap="previewImage"/></view>
  <view class="empty" wx:if="{{!about.length}}" bindtap="addRecord">记录彼此的喜好和共同日常，点这里添加</view>
  <view class="subtitle local-notice">云端功能测试中，旧本地记录尚未迁移，请勿清除小程序数据。</view>
  <view class="edit-link identity-link" bindtap="migrateLocal">复制本机旧记录到云端</view>
  <view class="edit-link identity-link" bindtap="getIdentity">获取当前微信身份标识（云端配置用）</view>
</view>
<view class="overlay" wx:if="{{editing}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="sheet-title">我们的资料</view><view class="field-label">成员 A 的称呼</view><input class="input" maxlength="12" placeholder="成员 A" value="{{draft.me}}" data-field="me" bindinput="input"/><view class="input" data-field="avatarA" bindtap="chooseAvatar">{{draft.avatarA ? '更换成员 A 头像' : '选择成员 A 头像（选填）'}} ›</view><view class="field-label">成员 B 的称呼</view><input class="input" maxlength="12" placeholder="成员 B" value="{{draft.partner}}" data-field="partner" bindinput="input"/><view class="input" data-field="avatarB" bindtap="chooseAvatar">{{draft.avatarB ? '更换成员 B 头像' : '选择成员 B 头像（选填）'}} ›</view><view class="field-label">在一起的日子</view><picker mode="date" end="{{today}}" value="{{draft.startDate || today}}" data-field="startDate" bindchange="dateChange"><view class="input">{{draft.startDate || '选择日期'}}</view></picker><view class="field-label">特别的纪念日（每年重复，可选）</view><picker mode="date" value="{{draft.anniversary || today}}" data-field="anniversary" bindchange="dateChange"><view class="input">{{draft.anniversary || '默认使用恋爱日期'}}</view></picker><view class="form-section">关于她的小细节</view><view class="field-label">星座（选填）</view><input class="input" maxlength="20" placeholder="例如：天秤座" value="{{draft.partnerZodiac}}" data-field="partnerZodiac" bindinput="input"/><view class="field-label">MBTI（选填）</view><input class="input" maxlength="20" placeholder="例如：INFP" value="{{draft.partnerMbti}}" data-field="partnerMbti" bindinput="input"/><view class="field-label">上升星座（选填）</view><input class="input" maxlength="20" placeholder="例如：上升狮子" value="{{draft.partnerRising}}" data-field="partnerRising" bindinput="input"/><view class="field-label">关于她的备忘录（选填）</view><textarea class="input textarea" maxlength="1000" placeholder="喜欢的食物、习惯，或你想记住的事情" value="{{draft.partnerMemo}}" data-field="partnerMemo" bindinput="input"/><button class="btn" disabled="{{busy}}" bindtap="save">{{busy ? '保存中…' : '保存'}}</button></view></view>
<view class="overlay" wx:if="{{showRecord}}" bindtap="closeRecord"><view class="sheet" catchtap="noop"><view class="sheet-title">{{record.id ? '编辑记录' : '添加记录'}}</view><picker range="{{owners}}" bindchange="ownerChange"><view class="input">归属：{{record.owner === '成员 A' ? profile.me : record.owner === '成员 B' ? profile.partner : '共同'}} ›</view></picker><input class="input" maxlength="30" placeholder="标题（最多 30 字）" value="{{record.title}}" data-field="title" bindinput="recordInput"/><textarea class="input textarea" maxlength="500" placeholder="写下喜好或共同日常" value="{{record.content}}" data-field="content" bindinput="recordInput"/><view class="image-grid editable"><view wx:if="{{record.images.length}}"><image src="{{record.images[0]}}" mode="aspectFill"/><text bindtap="removeImage">移除</text></view><view wx:else class="add-image" bindtap="chooseImage">＋<text>添加图片</text></view></view><button class="btn" bindtap="saveRecord">保存</button></view></view>
