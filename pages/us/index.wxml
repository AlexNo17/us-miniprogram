<view class="page">
  <view class="profile card"><view class="avatars"><view class="avatar">{{profile.me[0]}}</view><view class="heart">♥</view><view class="avatar second">{{profile.partner[0]}}</view></view><view class="names">{{profile.me}} 和 {{profile.partner}}</view><view class="subtitle">{{profile.startDate}} · 故事开始的日子</view></view>
  <view class="stats card"><view><text>{{days}}</text><label>相爱天数</label></view><view><text>{{momentCount}}</text><label>共同回忆</label></view><view><text>{{doneCount}}</text><label>完成计划</label></view></view>
  <view class="section-title">我们的设置</view>
  <view class="menu card"><view bindtap="coming"><text>♡</text>纪念日管理<label>›</label></view><view bindtap="coming"><text>♧</text>提醒与通知<label>›</label></view><view bindtap="coming"><text>◫</text>数据与隐私<label>›</label></view><view bindtap="coming"><text>⚙</text>关系设置<label>›</label></view></view>
  <view class="promise">仅属于两个人的私密空间 · 数据当前保存在本机</view>
</view>
