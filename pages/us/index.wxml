<view class="page">
  <view class="profile card"><view class="avatars"><view class="avatar">{{profile.me[0]}}</view><view class="heart">♥</view><view class="avatar second">{{profile.partner[0]}}</view></view><view class="names">{{profile.me}} 和 {{profile.partner}}</view><view class="subtitle">{{profile.startDate ? profile.startDate + ' · 故事开始的日子' : '设置属于你们的开始日期'}}</view><view class="edit-link" bindtap="edit">编辑我们的资料 ›</view></view>
  <view class="stats card"><view><text>{{days}}</text><label>相爱天数</label></view><view><text>{{momentCount}}</text><label>共同回忆</label></view><view><text>{{doneCount}}</text><label>完成计划</label></view></view>
  <view class="section-title">关于这个空间</view><view class="card about"><view>♡ &nbsp; 每一天都值得被记住</view><view class="subtitle">当前为本地体验版，记录仅保存在这台设备。换设备或清除小程序数据后，记录可能丢失。</view></view>
</view>
<view class="overlay" wx:if="{{editing}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="sheet-title">我们的资料</view><view class="field-label">我的昵称</view><input class="input" maxlength="12" placeholder="怎么称呼你" value="{{draft.me}}" data-field="me" bindinput="input"/><view class="field-label">TA 的昵称</view><input class="input" maxlength="12" placeholder="怎么称呼 TA" value="{{draft.partner}}" data-field="partner" bindinput="input"/><view class="field-label">在一起的日子</view><picker mode="date" end="{{today}}" value="{{draft.startDate || today}}" data-field="startDate" bindchange="dateChange"><view class="input">{{draft.startDate || '选择日期'}}</view></picker><view class="field-label">特别的纪念日（每年重复，可选）</view><picker mode="date" value="{{draft.anniversary || today}}" data-field="anniversary" bindchange="dateChange"><view class="input">{{draft.anniversary || '默认使用恋爱日期'}}</view></picker><button class="btn" bindtap="save">保存</button></view></view>
