.add { width: 76rpx; height: 76rpx; padding: 0; border: 0; border-radius: 50%; background: #df8955; color: white; font-size: 42rpx; line-height: 72rpx; }.add::after { border: 0; }.timeline { margin-top: 42rpx; }.entry { display: flex; align-items: stretch; }.rail { display: flex; width: 76rpx; align-items: center; flex-direction: column; }.mood { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; border-radius: 50%; background: #fff; font-size: 32rpx; box-shadow: 0 5rpx 18rpx rgba(100,68,60,.08); }.line { width: 2rpx; min-height: 140rpx; flex: 1; background: #f0d9dd; }.body { flex: 1; margin: 0 0 26rpx 12rpx; padding: 28rpx; }.date { color: #b09f9a; font-size: 22rpx; }.entry-title { margin: 10rpx 0; font-size: 31rpx; font-weight: 650; }.content { color: #746763; font-size: 26rpx; line-height: 1.7; }.textarea { width: auto; min-height: 180rpx; }

.delete { padding: 8rpx; color: #baaaa5; font-size: 22rpx; }
.tabs { margin-top: 32rpx; white-space: nowrap; }.tab { display: inline-block; padding: 14rpx 23rpx; margin-right: 12rpx; border-radius: 28rpx; background: #fff; color: #988985; font-size: 25rpx; }.tab.selected { background: #f6dfcc; color: #a75f32; }.memory { display: flex; align-items: center; gap: 22rpx; padding: 24rpx; }.memory-copy { flex: 1; min-width: 0; }.cover { width: 130rpx; height: 130rpx; flex-shrink: 0; border-radius: 18rpx; }.content { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
