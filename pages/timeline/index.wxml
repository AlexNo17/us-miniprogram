<view class="page">
  <view class="row space-between"><view><view class="title">回忆</view><view class="subtitle">把值得记住的时刻留在这里</view></view><button class="add" bindtap="openForm">＋</button></view>
  <scroll-view scroll-x class="tabs"><view class="tab {{filter === item ? 'selected' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-value="{{item}}" bindtap="setFilter">{{item}}</view></scroll-view>
  <view class="memory card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><image wx:if="{{item.images.length}}" class="cover" src="{{item.images[0]}}" mode="aspectFill"/><view class="memory-copy"><view class="muted small">{{item.category || '日常'}} · {{item.date || item.createdDate || '未设置日期'}}</view><view class="entry-title">{{item.title}}</view><view class="content">{{item.content}}</view></view><view class="muted">›</view></view>
  <view class="empty" wx:if="{{!filtered.length}}" bindtap="openForm">还没有回忆，点这里添加一条</view>
</view>
<view class="overlay" wx:if="{{detail}}" bindtap="closeDetail"><view class="sheet" catchtap="noop"><view class="row space-between"><view class="sheet-title">{{detail.title}}</view><view class="pill">{{detail.category || '日常'}}</view></view><view class="muted small">{{detail.date || detail.createdDate || '未设置日期'}}</view><view class="detail-text">{{detail.content || '这段回忆还没有文字。'}}</view><view class="image-grid"><image wx:for="{{detail.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="preview"/></view><view class="actions"><button class="secondary" bindtap="edit">编辑</button><button class="secondary" bindtap="remove">删除</button></view></view></view>
<view class="overlay" wx:if="{{showForm}}" bindtap="closeForm"><view class="sheet" catchtap="noop"><view class="sheet-title">{{form.id ? '编辑回忆' : '添加回忆'}}</view><picker range="{{categories}}" bindchange="category"><view class="input">分类：{{form.category}} ›</view></picker><input class="input" maxlength="50" placeholder="{{form.category === '电影' ? '填写片名' : form.category === '足迹' ? '填写地点' : '填写标题'}}" value="{{form.title}}" data-field="title" bindinput="input"/><textarea class="input textarea" maxlength="1000" placeholder="写下这段回忆（选填）" value="{{form.content}}" data-field="content" bindinput="input"/><view class="row"><picker class="grow" mode="date" end="{{today}}" value="{{form.date || today}}" bindchange="date"><view class="input">日期：{{form.date || '未设置（选填）'}} ›</view></picker><view wx:if="{{form.date}}" class="clear" bindtap="clearDate">清除</view></view><view class="small muted">图片 {{form.images.length}} / 9 · 首张为封面，点“前移”调整顺序</view><view class="image-grid editable"><view wx:for="{{form.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><view class="row space-between"><text data-index="{{index}}" bindtap="moveImage">前移</text><text data-index="{{index}}" bindtap="removeImage">移除</text></view></view><view class="add-image" bindtap="chooseImages">＋<text>添加图片</text></view></view><button class="btn" bindtap="save">保存回忆</button></view></view>
