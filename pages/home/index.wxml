<view class="page">
  <view class="hero">
    <view class="couple">{{profile.me}} <text>♥</text> {{profile.partner}}</view>
    <view class="hero-label">我们在一起的</view>
    <view class="days">{{days}}<text> 天</text></view>
    <view class="date">从 {{profile.startDate}} 开始</view>
  </view>
  <view class="card anniversary row space-between">
    <view><view class="pill">下一个纪念日</view><view class="anniv-title">我们的周年纪念</view></view>
    <view class="count"><text>{{countdown}}</text> 天</view>
  </view>
  <view class="quick row">
    <view class="quick-item" bindtap="goTimeline"><text>✎</text><view>记录今天</view></view>
    <view class="quick-item" bindtap="goPlans"><text>☆</text><view>新的计划</view></view>
  </view>
  <view class="section-title">最近的时光</view>
  <view class="mini card" wx:for="{{moments}}" wx:key="id"><view class="row space-between"><text class="mini-title">{{item.mood}} {{item.title}}</text><text class="muted">{{item.date}}</text></view><view class="mini-content">{{item.content}}</view></view>
  <view class="section-title">接下来一起</view>
  <view class="plan-line" wx:for="{{pending}}" wx:key="id"><view class="dot"></view><view class="grow"><view>{{item.title}}</view><text class="muted">{{item.date}} · {{item.category}}</text></view><text>›</text></view>
</view>
