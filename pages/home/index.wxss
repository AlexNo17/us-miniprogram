.hero { padding: 30rpx; border-radius: 28rpx; color: #714b34; text-align: left; background: #fff0e3; }
.setup { display: inline-block; margin-top: 36rpx; padding: 15rpx 28rpx; border: 1rpx solid rgba(255,255,255,.6); border-radius: 30rpx; }.home-empty { padding: 36rpx 20rpx; border-radius: 22rpx; background: #fff; font-size: 25rpx; }
.couple { font-size: 29rpx; }.couple text { margin: 0 14rpx; }.hero-label { margin-top: 44rpx; font-size: 25rpx; opacity: .86; }.days { margin: 6rpx 0; font-family: Georgia, serif; font-size: 100rpx; line-height: 1.2; }.days text { font-family: inherit; font-size: 30rpx; }.date { font-size: 24rpx; opacity: .82; }
.anniversary { padding: 28rpx 30rpx; }.anniv-title { margin-top: 18rpx; font-weight: 600; }.count text { font-family: Georgia, serif; font-size: 58rpx; color: #df8955; }.quick { gap: 20rpx; margin-top: 24rpx; }.quick-item { flex: 1; padding: 28rpx; border-radius: 24rpx; background: #fff; text-align: center; box-shadow: 0 10rpx 30rpx rgba(100,68,60,.05); font-size: 25rpx; }.quick-item text { display: block; margin-bottom: 8rpx; color: #df8955; font-size: 42rpx; }.mini { margin-top: 16rpx; padding: 26rpx; }.mini-title { font-weight: 600; }.mini .muted { font-size: 22rpx; }.mini-content { margin-top: 15rpx; color: #776965; font-size: 26rpx; }.plan-line { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; }.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #efb489; }.grow { flex: 1; }.grow .muted { font-size: 22rpx; }

