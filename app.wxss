page { background: #fffaf8; color: #342c2a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx 28rpx 140rpx; }
.title { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 10rpx; color: #988985; font-size: 26rpx; }
.card { margin-top: 28rpx; padding: 32rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(100, 68, 60, .07); }
.section-title { margin: 44rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 650; }
.btn { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; background: #e76f87; color: #fff; font-size: 30rpx; }
.btn::after { border: 0; }
.muted { color: #a29490; }
.pill { display: inline-flex; padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff0f2; color: #d75c75; font-size: 24rpx; }
.empty { padding: 80rpx 20rpx; text-align: center; color: #aa9c98; }
.overlay { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(37, 26, 24, .38); }
.sheet { width: 100%; padding: 38rpx 30rpx calc(38rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-title { margin-bottom: 28rpx; font-size: 36rpx; font-weight: 700; }
.input { margin-bottom: 22rpx; padding: 26rpx; border-radius: 20rpx; background: #faf6f4; font-size: 28rpx; }
.row { display: flex; align-items: center; }
.space-between { justify-content: space-between; }

