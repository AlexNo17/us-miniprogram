page { background: #fdf8f1; color: #342c2a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx 28rpx 140rpx; }
.title { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 10rpx; color: #988985; font-size: 26rpx; }
.card { margin-top: 28rpx; padding: 32rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(100, 68, 60, .07); }
.section-title { margin: 44rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 650; }
.btn { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; background: #df8955; color: #fff; font-size: 30rpx; }
.btn::after { border: 0; }
.muted { color: #a29490; }
.pill { display: inline-flex; padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff0e3; color: #bd7041; font-size: 24rpx; }
.empty { padding: 80rpx 20rpx; text-align: center; color: #aa9c98; }
.overlay { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(37, 26, 24, .38); }
.sheet { width: 100%; max-height: 90vh; overflow-y: auto; padding: 38rpx 30rpx calc(38rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-title { margin-bottom: 28rpx; font-size: 36rpx; font-weight: 700; }
.input { margin-bottom: 22rpx; padding: 26rpx; border-radius: 20rpx; background: #faf6f4; font-size: 28rpx; }
.row { display: flex; align-items: center; }
.space-between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }.small { font-size: 23rpx; }.clear { padding: 0 14rpx 20rpx; color: #bd7041; font-size: 24rpx; }.textarea { width: auto; min-height: 140rpx; }.detail-text { margin: 30rpx 0; color: #675a54; line-height: 1.7; white-space: pre-wrap; }.actions { display: flex; gap: 14rpx; margin-top: 30rpx; }.secondary { flex: 1; padding: 0 18rpx; background: #fbf3ec; color: #a9643a; font-size: 26rpx; }.secondary::after { border: 0; }.full { width: 100%; margin-top: 20rpx; }.image-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 20rpx 0; }.image-grid image, .add-image { width: 180rpx; height: 180rpx; border-radius: 16rpx; }.editable > view { width: 180rpx; }.editable text { color: #b37a58; font-size: 22rpx; }.add-image { display: flex; flex-direction: column; justify-content: center; align-items: center; background: #faf4ee; color: #c38864; font-size: 46rpx; }.add-image text { font-size: 21rpx; }

